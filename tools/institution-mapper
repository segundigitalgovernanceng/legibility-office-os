server.js
const express = require("express");
const mapper = require("./mapper");

const app = express();

app.use(express.json());

app.post("/map", (req, res) => {
    res.json(mapper.map(req.body));
});

app.get("/health", (req, res) => {
    res.json({
        status: "running"
    });
});

app.listen(8083);
