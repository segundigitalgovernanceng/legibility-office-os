server.js
const express = require("express");
const parser = require("./parser");

const app = express();

app.use(express.json());

app.post("/parse", (req, res) => {
    const result = parser.parse(req.body.text);

    res.json(result);
});

app.get("/health", (req, res) => {
    res.json({
        status: "running"
    });
});

app.listen(8081);
