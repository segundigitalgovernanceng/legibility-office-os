server.js
const express = require("express");

const app = express();

app.use(express.json());

app.post("/validate", (req, res) => {

    res.json({
        status: "valid",
        score: 87,
        maturity: 4
    });

});

app.get("/health", (req, res) => {

    res.json({
        status: "running"
    });

});

app.listen(8080);
