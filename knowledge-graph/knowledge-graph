server.js
const express = require("express");
const graph = require("./graph");

const app = express();

app.use(express.json());

app.post("/query", (req, res) => {

    res.json(graph.query(req.body));

});

app.get("/health", (req, res) => {

    res.json({

        status: "running"

    });

});

app.listen(8084);
