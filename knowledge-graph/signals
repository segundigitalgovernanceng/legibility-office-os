signal-schema.json
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Institutional Signal",
  "type": "object",
  "properties": {
    "signal": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "positive",
        "warning",
        "critical"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "trend": {
      "type": "string",
      "enum": [
        "improving",
        "stable",
        "declining"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "signal",
    "status"
  ]
}


